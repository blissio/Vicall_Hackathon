{
  "openapi": "3.1.0",
  "info": {
    "title": "Pittsburgh IQ research API",
    "version": "2.0.0",
    "description": "Local evidence research and optional model interpretation. Local API: X-Vicall-Token from the app or VICALL_API_TOKEN bearer credential. Team API: Basic account authentication or VICALL_TEAM_API_TOKEN bearer credential; role checks apply."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "security": [
    {
      "BearerToken": []
    },
    {
      "LocalToken": []
    },
    {
      "BasicAccount": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "LocalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Vicall-Token"
      },
      "BasicAccount": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Search": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000
          },
          "intent": {
            "type": "string",
            "enum": [
              "prospects",
              "providers",
              "partners"
            ],
            "default": "prospects"
          },
          "segment": {
            "type": "string",
            "enum": [
              "",
              "professional",
              "accounting",
              "legal",
              "insurance",
              "real_estate",
              "consulting",
              "education",
              "healthcare",
              "food",
              "technology",
              "other"
            ]
          },
          "organization_type": {
            "type": "string",
            "enum": [
              "",
              "business",
              "school",
              "school_district",
              "nonprofit",
              "public_body"
            ]
          },
          "category": {
            "type": "string"
          },
          "neighborhood": {
            "type": "string"
          },
          "desired_services": {
            "type": "string",
            "maxLength": 1000
          },
          "partner_services": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          },
          "require_contact": {
            "type": "boolean",
            "default": false
          },
          "require_decision_maker": {
            "type": "boolean",
            "default": false
          },
          "require_website_issue": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Ask": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000
          },
          "intent": {
            "type": "string",
            "enum": [
              "prospects",
              "providers",
              "partners"
            ],
            "default": "prospects"
          },
          "segment": {
            "type": "string",
            "enum": [
              "",
              "professional",
              "accounting",
              "legal",
              "insurance",
              "real_estate",
              "consulting",
              "education",
              "healthcare",
              "food",
              "technology",
              "other"
            ]
          },
          "organization_type": {
            "type": "string",
            "enum": [
              "",
              "business",
              "school",
              "school_district",
              "nonprofit",
              "public_body"
            ]
          },
          "category": {
            "type": "string"
          },
          "neighborhood": {
            "type": "string"
          },
          "desired_services": {
            "type": "string",
            "maxLength": 1000
          },
          "partner_services": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          },
          "require_contact": {
            "type": "boolean",
            "default": false
          },
          "require_decision_maker": {
            "type": "boolean",
            "default": false
          },
          "require_website_issue": {
            "type": "boolean",
            "default": false
          },
          "use_ai": {
            "type": "boolean",
            "default": false
          },
          "use_ai_plan": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "business_id",
          "name",
          "role",
          "source_url",
          "observed_at",
          "excerpt"
        ],
        "properties": {
          "business_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "expected_revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last-read revision; stale saves are rejected"
          },
          "id": {
            "type": "string",
            "description": "Existing contact ID when editing"
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "id",
          "organization_type",
          "source_url",
          "observed_at",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "organization_type": {
            "type": "string"
          },
          "services": {
            "type": "string"
          },
          "service_area": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "expected_revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last-read revision; stale saves are rejected"
          }
        }
      },
      "Workflow": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "maxLength": 12000
          },
          "shortlisted": {
            "type": "boolean"
          },
          "stage": {
            "type": "string",
            "enum": [
              "New",
              "Researching",
              "Qualified",
              "Not a fit"
            ]
          },
          "expected_updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SavedSearch": {
        "type": "object",
        "required": [
          "name",
          "query"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "query": {
            "$ref": "#/components/schemas/Search"
          }
        }
      },
      "Export": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditRequest": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "mobile",
              "desktop"
            ],
            "default": "mobile"
          }
        }
      },
      "MatchingSettings": {
        "type": "object",
        "required": [
          "weights"
        ],
        "properties": {
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relevance",
              "observed_need",
              "public_contact",
              "reviewed_role",
              "recent_evidence",
              "reviewed_identity",
              "partner_fit"
            ],
            "properties": {
              "relevance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "observed_need": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "public_contact": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "reviewed_role": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "recent_evidence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "reviewed_identity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "partner_fit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "Object": {
        "type": "object"
      }
    }
  },
  "paths": {
    "/api/link-audit": {
      "post": {
        "operationId": "link_audit",
        "summary": "Sample up to ten same-origin links",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or stale research revision"
          },
          "403": {
            "description": "Authentication, origin, token, or role denied"
          },
          "404": {
            "description": "Record not found"
          }
        }
      }
    },
    "/api/performance-audit": {
      "post": {
        "operationId": "performance_audit",
